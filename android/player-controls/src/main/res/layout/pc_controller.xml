<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="80dp"
        android:layout_gravity="top" android:gravity="top" android:paddingTop="8dp"
        android:paddingHorizontal="8dp" android:background="@drawable/pc_top_shade">
        <ImageButton android:id="@+id/pc_back" style="@style/PcIcon"
            android:src="@drawable/pc_back" android:contentDescription="@string/pc_back" />
        <TextView android:id="@+id/pc_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:gravity="center_vertical"
            android:textColor="#FFFFFF" android:textSize="15sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end" android:layout_marginHorizontal="8dp" />
        <ImageButton android:id="@+id/pc_help" style="@style/PcIcon"
            android:src="@drawable/pc_help" android:contentDescription="@string/pc_help" />
        <ImageButton android:id="@+id/pc_info" style="@style/PcIcon"
            android:src="@drawable/pc_info" android:contentDescription="@string/pc_info" />
        <ImageButton android:id="@+id/pc_rotate" style="@style/PcIcon"
            android:src="@drawable/pc_rotate" android:contentDescription="@string/pc_rotate" />
    </LinearLayout>

    <LinearLayout android:id="@id/exo_center_controls"
        android:layout_width="wrap_content" android:layout_height="80dp" android:layout_gravity="center"
        android:gravity="center" android:layoutDirection="ltr">
        <ImageButton android:id="@id/exo_rew" style="@style/PcIcon"
            android:layout_width="56dp" android:layout_height="56dp" android:layout_marginEnd="24dp"
            android:src="@drawable/pc_rewind" android:contentDescription="@string/pc_seek_back" />
        <ImageButton android:id="@id/exo_play_pause" style="@style/PcIcon"
            android:layout_width="72dp" android:layout_height="72dp" android:padding="12dp" android:contentDescription="@string/pc_play" />
        <ImageButton android:id="@id/exo_ffwd" style="@style/PcIcon"
            android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="24dp"
            android:src="@drawable/pc_forward" android:contentDescription="@string/pc_seek_forward" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="144dp"
        android:layout_gravity="bottom" android:orientation="vertical" android:gravity="bottom"
        android:paddingHorizontal="16dp" android:paddingTop="12dp" android:background="@drawable/pc_bottom_shade"
        android:layoutDirection="ltr">
        <LinearLayout android:layout_width="match_parent" android:layout_height="24dp">
            <TextView android:id="@id/exo_position" style="@style/PcTime" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@id/exo_duration" style="@style/PcTime" />
        </LinearLayout>
        <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress"
            android:layout_width="match_parent" android:layout_height="48dp"
            app:played_color="#B9CCFF" app:scrubber_color="#FFFFFF"
            app:buffered_color="#78889E" app:unplayed_color="#4DFFFFFF"
            app:bar_height="3dp" app:scrubber_enabled_size="10dp" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="48dp" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical">
            <TextView android:id="@id/exo_playback_speed" style="@style/PcAction" android:text="@string/pc_speed" />
            <TextView android:id="@+id/pc_ratio" style="@style/PcAction" android:text="@string/pc_ratio" />
            <TextView android:id="@+id/pc_lock" style="@style/PcAction" android:text="@string/pc_lock" />
            <ImageButton android:id="@id/exo_subtitle" style="@style/PcIcon"
                android:contentDescription="@string/pc_subtitles" />
            <ImageButton android:id="@id/exo_settings" style="@style/PcIcon"
                android:src="@drawable/pc_settings" android:contentDescription="@string/pc_settings" />
        </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</merge>
